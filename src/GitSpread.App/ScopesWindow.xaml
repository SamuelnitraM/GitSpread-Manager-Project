<Window x:Class="GitSpread.App.ScopesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AccountScopesViewModel}"
        Width="620" Height="640" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Form|Running}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Valider dans le navigateur" Command="{Binding ApplyCommand}" IsDefault="True"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Form}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Modifier et réessayer" Command="{Binding BackToFormCommand}" Margin="0,0,8,0"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Fermer" Command="{Binding CloseCommand}"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done|Failed}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,18">
                <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap">
                    <Run Text="Autorisations de " /><Run Text="{Binding Login, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Ce que GitSpread (via GitHub CLI) a le droit de faire sur ce compte. Coche ce que tu veux accorder, décoche ce que tu veux retirer." />

                <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                        Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                </Border>

                <!-- ===== Choix des autorisations ===== -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Form}" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Scopes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ScopeItemViewModel}">
                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,1" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WillBeAdded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WillBeRemoved}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WillBeAdded}" Value="True">
                                                                <Setter Property="Text" Value="sera ajoutée" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding WillBeRemoved}" Value="True">
                                                                <Setter Property="Text" Value="sera retirée" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanChange}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Label}">
                                            <StackPanel>
                                                <TextBlock><Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Name, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Muted}" /></TextBlock>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
                            <TextBlock Text="{Binding BrowserWarning}" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" />
                        </Border>
                        <TextBlock Text="Ce que GitSpread va exécuter" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <Border Background="{DynamicResource CodeBg}" CornerRadius="8" Padding="12,8">
                            <ItemsControl ItemsSource="{Binding Preview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='&gt; {0}'}" Foreground="{DynamicResource CodeText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ===== Validation dans le navigateur / résultat ===== -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Running|Done|Failed}">
                    <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="Transparent" Margin="0,0,0,12"
                                 Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Running}" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasDeviceCode}" Value="True" />
                                            <Condition Binding="{Binding Step}" Value="Running" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="1. Copie ce code à usage unique" FontWeight="SemiBold" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Copier" Command="{Binding CopyCodeCommand}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeviceCode}" FontFamily="Consolas" FontSize="30" FontWeight="Bold" />
                            </DockPanel>
                            <TextBlock Text="gh l'a déjà placé dans ton presse-papiers." Foreground="{DynamicResource Muted}" FontSize="12" />
                            <TextBlock Text="2. Colle-le sur la page GitHub et valide" FontWeight="SemiBold" Margin="0,14,0,8" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenDeviceUrlCommand}" HorizontalAlignment="Left">
                                <TextBlock><Run Text="Ouvrir " /><Run Text="{Binding DeviceUrl, Mode=OneWay}" /></TextBlock>
                            </Button>
                            <TextBlock Text="{Binding BrowserWarning}" Foreground="{DynamicResource Warning}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Background="{DynamicResource SuccessSoft}"
                            Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done}">
                        <TextBox Text="{Binding ResultMessage, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                    </Border>
                    <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Background="{DynamicResource DangerSoft}"
                            Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}">
                        <TextBox Text="{Binding ResultMessage, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Progress}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='•  {0}'}" Foreground="{DynamicResource Muted}" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
