<Window x:Class="GitSpread.App.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PublishViewModel}"
        Title="Publier sur GitHub" Width="680" Height="760" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Annuler" Command="{Binding CloseCommand}" Margin="0,0,8,0"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Form}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Publier sur GitHub" Command="{Binding PublishCommand}" IsDefault="True"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Form}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Modifier et réessayer" Command="{Binding BackToFormCommand}" Margin="0,0,8,0"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Voir sur GitHub" Command="{Binding OpenRepositoryCommand}" Margin="0,0,8,0"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Fermer" Command="{Binding CloseCommand}"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done|Failed}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,18">
                <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap">
                    <Run Text="Publier « " /><Run Text="{Binding ProjectName, Mode=OneWay}" /><Run Text=" » sur GitHub" />
                </TextBlock>
                <TextBlock Style="{StaticResource Hint}" FontSize="13"
                           Text="GitSpread crée un nouveau repo sur le compte choisi, y relie ce projet et envoie son contenu. Rien n'est envoyé avant que tu cliques sur « Publier »." />

                <!-- ================= Formulaire ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Form}">
                    <Border Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Aucun compte GitHub connecté : ajoute-en un avec le bouton « + » à côté des onglets." TextWrapping="Wrap" Foreground="{DynamicResource Warning}" />
                    </Border>

                    <TextBlock Text="Compte GitHub" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Login" Padding="6,4" />

                    <TextBlock Text="Nom du repo" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding RepositoryName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" BorderBrush="{DynamicResource Border}" />
                    <TextBlock Text="Lettres, chiffres, « - », « _ » et « . » uniquement." Style="{StaticResource Hint}" />

                    <TextBlock Text="Visibilité" Style="{StaticResource FieldLabel}" />
                    <UniformGrid Columns="2">
                        <RadioButton GroupName="IsPrivate" Style="{StaticResource ChoiceCard}" IsChecked="{Binding IsPrivate}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Privé" FontWeight="SemiBold" />
                                <TextBlock Text="Visible par toi seul (et tes invités)." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="IsPrivate" Style="{StaticResource ChoiceCard}" IsChecked="{Binding IsPrivate, Converter={StaticResource Not}}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Public" FontWeight="SemiBold" />
                                <TextBlock Text="Visible par tout le monde." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <TextBlock Text="Description (facultative)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" BorderBrush="{DynamicResource Border}" />

                    <TextBlock Text="Fichiers à ignorer (.gitignore)" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="Le projet a déjà un .gitignore : il est conservé tel quel." Foreground="{DynamicResource Muted}"
                               Visibility="{Binding HasGitignore, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Visibility="{Binding HasGitignore, Converter={StaticResource InverseBoolToVisibility}}">
                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" Padding="6,4" IsEditable="False" />
                        <TextBlock Text="{Binding GitignoreHint}" Style="{StaticResource Hint}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Évite d'envoyer sur GitHub les dépendances (node_modules, vendor...), les fichiers compilés et les fichiers de configuration locale." />
                    </StackPanel>

                    <TextBlock Text="Message du premier commit" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" BorderBrush="{DynamicResource Border}" />
                    <TextBlock Text="Utilisé seulement s'il y a des fichiers pas encore commités." Style="{StaticResource Hint}" />

                    <!-- Identité -->
                    <StackPanel DataContext="{Binding Identity}" Margin="0,14,0,0">
                        <TextBlock>
                            <Run Text="Commits signés par : " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <Border Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="10,8" Margin="0,6,0,0"
                                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" />
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="C'est bien mon adresse"
                                        Command="{Binding ConfirmEmailCommand}" Visibility="{Binding CanConfirmEmail, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="GitSpread s'en souviendra pour ce compte et ne t'avertira plus" />
                                <CheckBox Margin="0,8,0,0" Visibility="{Binding CanUseSuggested, Converter={StaticResource BoolToVisibility}}"
                                          IsChecked="{Binding DataContext.UseSuggestedIdentity, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock TextWrapping="Wrap"><Run Text="Signer les commits de ce projet avec " /><Run Text="{Binding SuggestedLabel, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Ce que GitSpread va exécuter" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                    <Border Background="{DynamicResource CodeBg}" CornerRadius="8" Padding="12,8">
                        <ItemsControl ItemsSource="{Binding Preview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='&gt; {0}'}" Foreground="{DynamicResource CodeText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>

                <!-- ================= En cours / résultat ================= -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Running|Done|Failed}">
                    <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="Transparent" Margin="0,0,0,12"
                                 Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Running}" />

                    <Border Background="{DynamicResource SuccessSoft}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done}">
                        <StackPanel>
                            <TextBlock Text="Projet publié" FontWeight="SemiBold" Foreground="{DynamicResource Success}" FontSize="15" />
                            <TextBox Text="{Binding RepositoryUrl, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource DangerSoft}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}">
                        <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Progress}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='•  {0}'}" Foreground="{DynamicResource Muted}" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
