<UserControl x:Class="GitSpread.App.Views.HistoryExplorerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
        xmlns:git="clr-namespace:GitSpread.Core.Git;assembly=GitSpread.Core"
        xmlns:views="clr-namespace:GitSpread.App.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HistoryExplorerViewModel}">
    <!-- Historique en grand (F6a), à la place du contenu de l'onglet : les onglets restent accessibles -->
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedProjects" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}" AutomationProperties.Name="Retour aux projets"
                        ToolTip="Revenir à la liste des projets de cet onglet">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Retour aux projets" /></StackPanel>
                </Button>
                <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}" Margin="16,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Historique" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <ProgressBar IsIndeterminate="True" Width="60" Height="3" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}"
                             VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Compte rendu de la dernière action sur une branche (F6b) -->
            <Border HorizontalAlignment="Right" CornerRadius="6" Padding="10,4" BorderThickness="1" MaxWidth="760"
                    Visibility="{Binding HasLastAction, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding LastAction.Commands}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LastAction.Succeeded}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding LastAction.Icon}" Style="{StaticResource Glyph}" Margin="0,2,8,0" VerticalAlignment="Top" />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.Name="Compte rendu">
                        <Run Text="{Binding LastAction.Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding LastAction.Message, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="220" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="440" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ============ Gauche : projets et branches ============ -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}">
            <TabControl SelectedIndex="{Binding LeftTab}" Background="Transparent" BorderThickness="0" Padding="0" Margin="8,8,4,8">
                <TabItem Header="Projets" AutomationProperties.Name="Projets">
                    <DockPanel Margin="0,8,0,0">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="26,5,6,5" BorderBrush="{DynamicResource Border}"
                                     AutomationProperties.Name="Filtrer les projets" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Source={StaticResource GroupedProjects}}" SelectedItem="{Binding SelectedItem}" IsSynchronizedWithCurrentItem="False" BorderThickness="0"
                                 Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Liste des projets">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" Margin="6,10,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ExplorerItem}">
                                    <DockPanel Margin="0,2">
                                        <TextBlock x:Name="Icon" DockPanel.Dock="Left" Text="&#xE80F;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}"
                                                   Margin="0,3,8,0" VerticalAlignment="Top" ToolTip="Projet sur ce poste" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Project}" Value="{x:Null}">
                                            <Setter TargetName="Icon" Property="Text" Value="&#xE753;" />
                                            <Setter TargetName="Icon" Property="ToolTip" Value="Repo sur GitHub, pas encore cloné sur ce poste" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Branches" AutomationProperties.Name="Branches">
                    <ListBox x:Name="BranchList" DataContext="{Binding History}" ItemsSource="{Binding Branches}" BorderThickness="0" Background="Transparent" Margin="0,8,0,0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Branch_SelectionChanged"
                             AutomationProperties.Name="Liste des branches">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BranchRowViewModel}">
                                <DockPanel Margin="0,4" ToolTip="Clique pour voir le dernier commit de cette branche dans l'historique">
                                    <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,8,0" VerticalAlignment="Top">
                                        <Ellipse x:Name="Dot" Fill="{Binding Color, Converter={StaticResource BranchBrush}}" />
                                        <Ellipse x:Name="Ring" Stroke="{Binding Color, Converter={StaticResource BranchBrush}}" StrokeThickness="2" StrokeDashArray="1.5 1" Visibility="Collapsed" />
                                    </Grid>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="6,0,0,0" />
                                            <TextBlock x:Name="BranchName" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding StateLabel}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text}" Opacity="0.85" />
                                        <TextBlock Text="{Binding LastCommit}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />

                                        <!-- Actions sur la branche choisie (F6b) -->
                                        <WrapPanel x:Name="Actions" Margin="-6,4,0,0" Visibility="Collapsed"
                                                   IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <WrapPanel.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                                </Style>
                                            </WrapPanel.Resources>
                                            <Button Content="{Binding SwitchLabel}" Command="{Binding DataContext.SwitchBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Passer sur cette branche : tes fichiers prennent son contenu (tes modifications en cours te sont proposées)" />
                                            <Button Content="{Binding IntegrateLabel}" Command="{Binding DataContext.IntegrateBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanIntegrate, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Ajouter le travail de cette branche dans la branche principale (analyse et confirmation avant)" />
                                            <Button Content="{Binding PushLabel}" Command="{Binding DataContext.PushBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanPush, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Envoyer cette branche sur GitHub (jamais de force)" />
                                            <Button Content="Renommer…" Command="{Binding DataContext.RenameBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="Renommer la branche ici et, si elle y est, sur GitHub" />
                                            <Button Content="Supprimer…" Command="{Binding DataContext.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" Foreground="{DynamicResource Danger}"
                                                    ToolTip="Supprimer la branche sur ce poste (et, si tu le choisis, sur GitHub). Tu es prévenu si du travail serait perdu." />
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRemoteOnly}" Value="True">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="BranchName" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>
        </Border>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />

        <!-- ============ Centre : graphe ============ -->
        <DockPanel Grid.Column="2" DataContext="{Binding History}">
            <DockPanel DockPanel.Dock="Top" Margin="14,12,10,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ReloadCommand}" AutomationProperties.Name="Relire l historique"
                        ToolTip="Relire l'historique">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
                </Button>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <!-- Recherche dans l'historique chargé (F6e) -->
            <StackPanel DockPanel.Dock="Top" Margin="14,0,10,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding PreviousMatchCommand}" AutomationProperties.Name="Résultat précédent" ToolTip="Résultat précédent (plus récent)">
                            <TextBlock Text="&#xE70E;" Style="{StaticResource Glyph}" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding NextMatchCommand}" AutomationProperties.Name="Résultat suivant" ToolTip="Résultat suivant (plus ancien)">
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Effacer la recherche" ToolTip="Effacer la recherche">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="11" />
                        </Button>
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="26,4,6,4"
                                 AutomationProperties.Name="Rechercher dans l historique" KeyDown="Search_KeyDown"
                                 ToolTip="Message, auteur, SHA, branche ou tag. Entrée : résultat suivant, Maj+Entrée : précédent." />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="Rechercher un commit (message, auteur, SHA, branche)" Foreground="{DynamicResource Muted}" Margin="28,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding HasSearch, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </DockPanel>
                <TextBlock Text="{Binding SearchSummary}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <views:HistoryView ShowLegend="True" />
        </DockPanel>
        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />

        <!-- ============ Droite : commit choisi ============ -->
        <Border Grid.Column="4" Background="{DynamicResource Surface}" DataContext="{Binding History}">
            <Grid>
                <TextBlock Text="Choisis un commit dans l'historique pour voir ce qu'il a changé." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                           Visibility="{Binding HasDetails, Converter={StaticResource InverseBoolToVisibility}}" />
                <!-- Colonne entière défilante : même avec un long message et beaucoup de fichiers, on descend jusqu'aux modifications -->
                <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="16,12">
                    <Expander Style="{StaticResource Section}" Header="COMMIT SÉLECTIONNÉ" Margin="0"
                              IsExpanded="{Binding DataContext.Sections.HistoryCommit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <StackPanel>
                        <TextBox Text="{Binding Details.Message, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                 MaxHeight="120" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}">
                            <Run Text="{Binding AuthorLabel, Mode=OneWay}" Foreground="{DynamicResource Text}" /><Run Text=" · " /><Run Text="{Binding DateLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBox Text="{Binding Details.Commit.Sha, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Muted}" />
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding DataContext.CreateBranchHereCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                AutomationProperties.Name="Créer une branche à partir de ce commit"
                                ToolTip="Nouvelle branche qui part de ce commit : utile pour repartir d'une version précédente sans toucher aux autres branches">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Créer une branche à partir de ce commit…" /></StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ParentsLabel}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />

                    </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource Section}" Header="PRÉSENT DANS LES BRANCHES"
                              IsExpanded="{Binding DataContext.Sections.HistoryBranches, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Details.Branches}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="0,0,5,4">
                                        <TextBlock Text="{Binding}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource Section}" Header="{Binding FilesHeader}"
                              IsExpanded="{Binding DataContext.Sections.HistoryFiles, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <StackPanel>
                        <!-- F6e : seulement les fichiers modifiés par ce commit, ou tout le projet tel qu'il était à ce commit -->
                        <Border Background="{DynamicResource SegmentBg}" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" IsChecked="{Binding ShowChangedFiles}" AutomationProperties.Name="Fichiers modifiés par ce commit"
                                             ToolTip="Seulement les fichiers ajoutés, modifiés, renommés ou supprimés par ce commit">
                                    <TextBlock Text="{Binding ChangedTabLabel}" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" IsChecked="{Binding ShowAllFiles}" AutomationProperties.Name="Tous les fichiers du projet à ce commit"
                                             ToolTip="Tout le projet tel qu'il était à ce commit">
                                    <TextBlock Text="{Binding AllTabLabel}" />
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding FilesLabel}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding NoChangedFilesShown, Converter={StaticResource BoolToVisibility}}" />
                        <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" MaxHeight="190"
                                 Visibility="{Binding ShowChangedFiles, Converter={StaticResource BoolToVisibility}}" PreviewMouseWheel="Nested_PreviewMouseWheel" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                                 Background="Transparent" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Fichiers modifiés">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type git:CommitFile}">
                                    <DockPanel>
                                        <Border x:Name="Badge" DockPanel.Dock="Left" Width="20" CornerRadius="4" Margin="0,0,8,0" Background="{DynamicResource AccentSoft}">
                                            <TextBlock x:Name="Letter" Text="{Binding StatusLetter}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Accent}" />
                                        </Border>
                                        <TextBlock x:Name="OldPath" DockPanel.Dock="Right" Text="{Binding OldPath, StringFormat='← {0}'}" Foreground="{DynamicResource Muted}"
                                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="160" ToolTip="{Binding OldPath}" />
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="A">
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SuccessSoft}" />
                                            <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource Success}" />
                                            <Setter TargetName="Badge" Property="ToolTip" Value="Ajouté" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="D">
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerSoft}" />
                                            <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource Danger}" />
                                            <Setter TargetName="Badge" Property="ToolTip" Value="Supprimé" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="R">
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource WarningSoft}" />
                                            <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource Warning}" />
                                            <Setter TargetName="Badge" Property="ToolTip" Value="Renommé ou déplacé" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="M">
                                            <Setter TargetName="Badge" Property="ToolTip" Value="Modifié" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OldPath}" Value="{x:Null}">
                                            <Setter TargetName="OldPath" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Arborescence complète au commit choisi (F6e) : les dossiers se construisent à l'ouverture -->
                        <StackPanel Visibility="{Binding ShowAllFiles, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,6">
                                <TextBox Text="{Binding TreeFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="26,4,6,4"
                                         AutomationProperties.Name="Filtrer les fichiers" ToolTip="Partie du nom ou du chemin d'un fichier" />
                                <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock Text="Filtrer les fichiers (nom ou chemin)" Foreground="{DynamicResource Muted}" Margin="28,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding HasTreeFilter, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                            <TextBlock Text="Lecture des fichiers…" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,4"
                                       Visibility="{Binding IsLoadingTree, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding TreeNote}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Visibility="{Binding HasTreeNote, Converter={StaticResource BoolToVisibility}}" />
                            <TreeView ItemsSource="{Binding Tree}" MaxHeight="260" PreviewMouseWheel="Nested_PreviewMouseWheel" SelectedItemChanged="Tree_SelectedItemChanged"
                                      BorderThickness="1" BorderBrush="{DynamicResource Border}" Background="Transparent"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      AutomationProperties.Name="Fichiers du projet à ce commit">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:FileTreeNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Icon" Text="&#xE7C3;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <Border x:Name="Badge" Width="18" CornerRadius="4" Margin="0,0,6,0" Background="{DynamicResource AccentSoft}" Visibility="Collapsed">
                                                <TextBlock x:Name="Letter" Text="{Binding StatusLetter}" FontFamily="Consolas" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource Accent}" />
                                            </Border>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter TargetName="Icon" Property="Text" Value="&#xE8B7;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasChange}" Value="True">
                                                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLetter}" Value="A">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SuccessSoft}" />
                                                <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource Success}" />
                                                <Setter TargetName="Badge" Property="ToolTip" Value="Ajouté par ce commit" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLetter}" Value="R">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource WarningSoft}" />
                                                <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource Warning}" />
                                                <Setter TargetName="Badge" Property="ToolTip" Value="Renommé ou déplacé par ce commit" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLetter}" Value="M">
                                                <Setter TargetName="Badge" Property="ToolTip" Value="Modifié par ce commit" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource Section}" Header="{Binding DiffHeader}"
                              IsExpanded="{Binding DataContext.Sections.HistoryDiff, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <!-- Diff : lignes ajoutées en vert, retirées en rouge. Il occupe la hauteur visible de la colonne et défile lui-même. -->
                    <DockPanel Height="{Binding ViewportHeight, ElementName=DetailsScroll}" MinHeight="220">
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding ViewedPath, Converter={StaticResource NullToCollapsed}}">
                        <WrapPanel Margin="0,0,0,4">
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Margin" Value="0,0,4,2" />
                                </Style>
                            </WrapPanel.Resources>
                            <Button Content="Voir le fichier entier" Command="{Binding ShowWholeFileCommand}"
                                    Visibility="{Binding CanShowWholeFile, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Le fichier complet tel qu'il était à ce commit" />
                            <Button Content="Voir les modifications" Command="{Binding ShowChangesCommand}"
                                    Visibility="{Binding CanShowChanges, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Ce que ce commit a changé dans ce fichier (en vert et rouge)" />
                            <Button Content="Copier le chemin" Command="{Binding CopyPathCommand}" />
                            <Button Content="Enregistrer cette version sous…" Command="{Binding SaveVersionCommand}"
                                    Visibility="{Binding ViewedFileExists, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Écrit une copie de ce fichier, tel qu'il était à ce commit, où tu veux. Le projet n'est pas touché." />
                            <Button Content="Restaurer dans le projet…" Command="{Binding DataContext.RestoreFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanRestoreFile, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Remet ce fichier comme il était à ce commit. L'historique ne change pas : la restauration sera un changement à commiter." />
                        </WrapPanel>
                        <TextBlock Text="{Binding FileStatus}" Foreground="{DynamicResource Success}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding FileStatus, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding ContentNote}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding ContentNoteShown, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Grid>
                        <ListBox ItemsSource="{Binding Diff}" Visibility="{Binding IsShowingChanges, Converter={StaticResource BoolToVisibility}}" BorderThickness="1" BorderBrush="{DynamicResource Border}" Background="{DynamicResource Bg}"
                                 PreviewMouseWheel="Nested_PreviewMouseWheel"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Modifications du fichier">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type git:DiffLine}">
                                    <Border x:Name="Line" Padding="6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Sign" Text=" " FontFamily="Consolas" FontSize="12" Width="14" Foreground="{DynamicResource Muted}" />
                                            <TextBlock x:Name="Code" Text="{Binding Text}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Text}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource DiffAddedBg}" />
                                            <Setter TargetName="Sign" Property="Text" Value="+" />
                                            <Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource DiffAddedText}" />
                                            <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource DiffAddedText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource DiffRemovedBg}" />
                                            <Setter TargetName="Sign" Property="Text" Value="−" />
                                            <Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource DiffRemovedText}" />
                                            <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource DiffRemovedText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Hunk">
                                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                            <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource Muted}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Header">
                                            <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource Muted}" />
                                            <Setter TargetName="Code" Property="FontFamily" Value="Segoe UI" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}"
                                     Visibility="{Binding IsLoadingDiff, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Contenu du fichier à ce commit (F6e) : texte avec numéros de ligne, ou aperçu d'image -->
                        <ListBox ItemsSource="{Binding ContentLines}" BorderThickness="1" BorderBrush="{DynamicResource Border}" Background="{DynamicResource Bg}"
                                 PreviewMouseWheel="Nested_PreviewMouseWheel"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Contenu du fichier"
                                 Visibility="{Binding IsShowingContent, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileLine}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Number}" FontFamily="Consolas" FontSize="12" Width="44" TextAlignment="Right" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource Muted}" />
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12"
                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Image x:Name="Preview" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Source="{Binding ImagePath, Converter={StaticResource FileToImage}}" AutomationProperties.Name="Aperçu de l image" />
                        </Border>
                    </Grid>
                    </DockPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</UserControl>
