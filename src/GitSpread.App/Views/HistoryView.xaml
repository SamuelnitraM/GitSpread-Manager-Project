<UserControl x:Class="GitSpread.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
             xmlns:controls="clr-namespace:GitSpread.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HistoryViewModel}" x:Name="Root">
    <!-- Graphe des branches et liste des commits (F6a) : aperçu en bas de page et centre de la grande fenêtre -->
    <Grid>
        <DockPanel>
            <!-- Pied : légende (grande fenêtre) et « Afficher plus » -->
            <DockPanel DockPanel.Dock="Bottom" Margin="8,4,8,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                               Visibility="{Binding ShowLegend, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding LoadMoreCommand}" AutomationProperties.Name="Afficher plus de commits"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" ToolTip="Charger les commits plus anciens">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0" /><TextBlock Text="Afficher plus" FontSize="12" /></StackPanel>
                    </Button>
                </StackPanel>

                <!-- Légende en mots simples -->
                <Border Visibility="{Binding ShowLegend, ElementName=Root, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Left"
                        Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <WrapPanel>
                        <WrapPanel.Resources>
                            <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
                        </WrapPanel.Resources>
                        <Ellipse Width="11" Height="11" Fill="{DynamicResource BranchMain}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="branche principale" Margin="0,0,14,0" />
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource BranchClassic0}" Margin="0,0,2,0" VerticalAlignment="Center" />
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource BranchClassic1}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="autres branches" Margin="0,0,14,0" />
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource BranchMaint0}" Margin="0,0,2,0" VerticalAlignment="Center" />
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource BranchMaint1}" Margin="0,0,2,0" VerticalAlignment="Center" />
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource BranchMaint2}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="corrections (fix, hotfix, debug…)" Margin="0,0,14,0" />
                        <Ellipse Width="10" Height="10" Stroke="{DynamicResource Muted}" StrokeThickness="2.5" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="fusion (deux branches réunies)" Margin="0,0,14,0" />
                        <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource Muted}" StrokeThickness="2" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Muted}" />
                        </Grid>
                        <TextBlock Text="ta position actuelle" Margin="0,0,14,0" />
                        <Border BorderBrush="{DynamicResource Muted}" BorderThickness="1" CornerRadius="8" Padding="5,0" Margin="0,0,5,0" VerticalAlignment="Center">
                            <TextBlock Text="origin/…" FontSize="10" />
                        </Border>
                        <TextBlock Text="version sur GitHub" />
                    </WrapPanel>
                </Border>
            </DockPanel>

            <ListBox x:Name="Commits" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0" Background="Transparent"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="Commits_DoubleClick" AutomationProperties.Name="Historique des commits">
                <ListBox.ItemContainerStyle>
                    <!-- Lignes collées les unes aux autres, sans marge : les traits du graphe doivent être continus -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="6,0">
                                        <ContentPresenter VerticalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:GraphCell Grid.Column="0" Row="{Binding Graph}" IsMerge="{Binding Commit.IsMerge}" IsHead="{Binding Commit.IsHead}"
                                                Width="{Binding DataContext.GraphWidth, ElementName=Root}" />
                            <DockPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Refs}" Visibility="{Binding HasRefs, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RefPill}">
                                            <Border x:Name="Pill" CornerRadius="9" Padding="7,1" Margin="0,0,5,0" BorderThickness="1"
                                                    Background="{Binding Color, Converter={StaticResource BranchBrush}}" BorderBrush="{Binding Color, Converter={StaticResource BranchBrush}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TagGlyph" Text="&#xE8EC;" Style="{StaticResource Glyph}" FontSize="10" Margin="0,0,4,0" Visibility="Collapsed" />
                                                    <TextBlock x:Name="PillText" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bg}" />
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRemote}" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="PillText" Property="Foreground" Value="{Binding Color, Converter={StaticResource BranchBrush}}" />
                                                    <Setter TargetName="PillText" Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTag}" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Muted}" />
                                                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Muted}" />
                                                    <Setter TargetName="TagGlyph" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="TagGlyph" Property="Foreground" Value="{DynamicResource Muted}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHead}" Value="True">
                                                    <Setter TargetName="Pill" Property="BorderThickness" Value="2" />
                                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Text}" />
                                                    <Setter TargetName="Pill" Property="ToolTip" Value="Branche actuelle : c'est ici que tes prochains commits iront" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Subject}" />
                            </DockPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Author}" Foreground="{DynamicResource Muted}" FontSize="12" MaxWidth="150" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="3" Text="{Binding DateLabel}" ToolTip="{Binding DateTooltip}" Foreground="{DynamicResource Muted}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="70" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding ShortSha}" FontFamily="Consolas" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Message : pas de projet, pas de git, pas encore cloné… -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CloneCommand}" HorizontalAlignment="Center" Margin="0,10,0,0"
                    AutomationProperties.Name="Cloner en local" Visibility="{Binding CanClone, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Cloner en local…" /></StackPanel>
            </Button>
        </StackPanel>
        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
