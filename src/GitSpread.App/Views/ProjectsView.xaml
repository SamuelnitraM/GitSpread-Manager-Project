<UserControl x:Class="GitSpread.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:TabViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- ============ Liste des projets ============ -->
        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ProjectsSummary}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Grid MaxWidth="340" HorizontalAlignment="Left">
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="26,5,6,5" VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource Border}" MinWidth="240" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Filtrer par nom, repo ou chemin" Foreground="{DynamicResource Muted}" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <Grid>
                <ListView ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                          PreviewMouseLeftButtonDown="Projects_PreviewMouseDown" PreviewMouseMove="Projects_PreviewMouseMove"
                          BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="16,8" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Ouvrir le dossier" Command="{Binding OpenFolderCommand}" />
                                        <MenuItem Header="Ouvrir sur GitHub" Command="{Binding OpenOnGitHubCommand}" IsEnabled="{Binding CanOpenOnGitHub}" />
                                        <Separator />
                                        <MenuItem Header="Copier le chemin" Command="{Binding CopyPathCommand}" />
                                        <Separator Visibility="{Binding IsExtra, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Retirer de GitSpread" Command="{Binding RemoveFromListCommand}"
                                                  Visibility="{Binding IsExtra, Converter={StaticResource BoolToVisibility}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectItemViewModel}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <Border Style="{StaticResource Pill}" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                                            Visibility="{Binding HasProtocol, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ProtocolLabel}" FontSize="11" Foreground="{DynamicResource Muted}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Background="{DynamicResource AccentSoft}" ToolTip="{Binding SharingLabel}"
                                            Visibility="{Binding IsShared, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{DynamicResource Accent}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding SharingBadge}" FontSize="11" Foreground="{DynamicResource Accent}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="22,2,0,0" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding RemoteLabel, Mode=OneWay}" />
                                    <Run Text="  ·  " /><Run Text="{Binding Path, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="22,2,0,0" Text="{Binding UnlinkedReasonLabel}" Foreground="{DynamicResource Warning}" FontSize="12"
                                           Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Aucun projet local rattaché ici." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasNoProjects, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="Analyse des dossiers…" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>

        <!-- ============ Panneau de détails ============ -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock Text="Sélectionne un projet pour voir son état." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedProject}"
                              Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="20,16" d:DataContext="{d:DesignInstance vm:ProjectItemViewModel}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ReloadCommand}" AutomationProperties.Name="Relire l état" ToolTip="Relire l'état du projet" VerticalAlignment="Top">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
                            </Button>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBox Text="{Binding Path, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />

                        <Border Margin="0,10,0,0" Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="10,6"
                                Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding UnlinkedReasonLabel}" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" />
                        </Border>
                        <TextBlock Text="Astuce : glisse ce projet sur l'onglet d'un compte pour le ranger dans ses projets locaux (rien n'est créé sur GitHub)."
                                   Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding ShowAssignHint, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Projet sans remote rangé à la main dans ce compte -->
                        <Border Margin="0,10,0,0" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="10,6"
                                Visibility="{Binding IsAssigned, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding AssignedLabel}" TextWrapping="Wrap" />
                                <Button Style="{StaticResource GhostButton}" Command="{Binding UnassignCommand}" HorizontalAlignment="Left" Margin="-6,4,0,0"
                                        AutomationProperties.Name="Remettre dans Non liés" Content="Remettre dans « Non liés »"
                                        ToolTip="Le projet quitte cet onglet ; ses fichiers ne sont pas touchés. Tu peux aussi le glisser sur l'onglet « Non liés »." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DÉPÔT LIÉ" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RemoteLabel}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Pill}" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                                    Visibility="{Binding HasProtocol, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ProtocolLabel}" FontSize="11" Foreground="{DynamicResource Muted}" />
                            </Border>
                        </StackPanel>
                        <TextBox Text="{Binding RemoteDetail, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Muted}" FontSize="12"
                                 Visibility="{Binding HasRemote, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Repo partagé entre plusieurs comptes connectés (F3A) -->
                        <Border Margin="0,10,0,0" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="10,6"
                                Visibility="{Binding IsShared, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE716;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding SharingLabel}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <StackPanel Visibility="{Binding HasPushAccountChoice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ENVOYER AVEC LE COMPTE" Style="{StaticResource SectionLabel}" />
                            <ComboBox ItemsSource="{Binding PushAccountChoices}" SelectedItem="{Binding SelectedPushAccount}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="Envoyer avec le compte" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                      ToolTip="Compte GitHub utilisé pour Récupérer, Tirer et Pousser ce projet" />
                            <TextBlock Text="{x:Static vm:ProjectItemViewModel.PushAccountNote}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>


                        <!-- ============ Actions ============ -->
                        <TextBlock Text="ACTIONS" Style="{StaticResource SectionLabel}" />

                        <!-- Branche sur laquelle on travaille (et qu'on pousse / tire) -->
                        <DockPanel Margin="0,0,0,10" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding NewBranchCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="Nouvelle branche" ToolTip="Créer une nouvelle branche à partir d'ici">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,5,0" />
                                    <TextBlock Text="Nouvelle branche" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE8D4;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                            <Grid>
                                <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Label"
                                          AutomationProperties.Name="Branche" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                          ToolTip="Branche actuelle : les boutons Tirer, Pousser et Commit agissent sur elle"
                                          Visibility="{Binding HasMultipleBranches, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding BranchLabel}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Visibility="{Binding HasMultipleBranches, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </DockPanel>

                        <!-- Dossier pas encore suivi par git -->
                        <StackPanel Visibility="{Binding CanInit, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Ce dossier n'est pas encore suivi par git." TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding InitCommand}" AutomationProperties.Name="Initialiser git" Margin="0,0,8,8"
                                        ToolTip="git init : crée l'historique git du dossier, sans rien envoyer">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Initialiser git" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PublishCommand}" AutomationProperties.Name="Publier sur GitHub" Margin="0,0,8,8"
                                        ToolTip="Créer un repo GitHub pour ce projet et l'y envoyer.">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Publier sur GitHub…" /></StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Dépôt local sans remote -->
                        <WrapPanel Visibility="{Binding IsLocalRepository, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding CommitCommand}" AutomationProperties.Name="Commit" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Commit…" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding PublishCommand}" AutomationProperties.Name="Publier sur GitHub" Margin="0,0,8,8"
                                    ToolTip="Créer un repo GitHub pour ce projet et l'y envoyer.">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Publier sur GitHub…" /></StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Projet relié à un dépôt distant -->
                        <StackPanel Visibility="{Binding CanSync, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding FetchCommand}" AutomationProperties.Name="Récupérer" Margin="0,0,8,8"
                                        ToolTip="git fetch : regarde ce qui a changé sur GitHub, sans rien modifier dans tes fichiers">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Récupérer" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PullCommand}" AutomationProperties.Name="Tirer" Margin="0,0,8,8"
                                        ToolTip="git pull --ff-only : applique les nouveaux commits de GitHub à tes fichiers (sans fusion automatique)">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="{Binding PullLabel}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PushCommand}" AutomationProperties.Name="Pousser" Margin="0,0,8,8"
                                        ToolTip="git push : envoie tes commits sur GitHub (jamais de force)">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="{Binding PushLabel}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CommitCommand}" AutomationProperties.Name="Commit" Margin="0,0,8,8"
                                        ToolTip="Enregistre tes modifications dans l'historique (git add + git commit)">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Commit…" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ChangeLinkedRepoCommand}" AutomationProperties.Name="Changer le repo lié" Margin="0,0,8,8"
                                        ToolTip="Relier ce projet à un autre repo, sur ce compte ou un autre. Tu peux aussi glisser le projet sur l'onglet d'un autre compte.">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Changer le repo lié…" /></StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="{Binding NetworkAccountLabel}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="3" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="Transparent" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BusyLabel}" Foreground="{DynamicResource Muted}" />
                        </StackPanel>

                        <!-- Opération en cours (fusion avec conflits...) -->
                        <Border Margin="0,10,0,0" CornerRadius="8" Padding="12,10" Background="{DynamicResource WarningSoft}"
                                Visibility="{Binding HasOperation, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Warning}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding OperationLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ConflictFiles}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='•  {0}'}" FontFamily="Consolas" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"
                                           Text="Ouvre ces fichiers, garde la bonne version entre les marqueurs &lt;&lt;&lt;&lt;&lt;&lt;&lt; et &gt;&gt;&gt;&gt;&gt;&gt;&gt; puis supprime les marqueurs. Clique ensuite sur l'icône Relire, puis « Terminer la fusion »." />
                                <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Terminer la fusion" Command="{Binding ConcludeMergeCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding CanConcludeMerge, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Abandonner" Command="{Binding AbortOperationCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Ouvrir le dossier" Command="{Binding OpenFolderCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Compte rendu de la dernière action -->
                        <Border Margin="0,10,0,0" CornerRadius="8" Padding="12,10" BorderThickness="1"
                                Visibility="{Binding HasLastAction, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastAction.Succeeded}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LastAction.Icon}" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding LastAction.Title}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBox Text="{Binding LastAction.Message, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,4,0,0" />
                                <TextBox Text="{Binding LastAction.Commands, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="12"
                                         Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
                                <Expander Header="Sortie complète" Margin="0,6,0,0" FontSize="12"
                                          Visibility="{Binding LastAction.HasOutput, Converter={StaticResource BoolToVisibility}}">
                                    <TextBox Text="{Binding LastAction.Output, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="11"
                                             MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Lecture de l'état git…" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"
                                   Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}" />
                        <Border Margin="0,14,0,0" Background="{DynamicResource DangerSoft}" CornerRadius="6" Padding="10,6"
                                Visibility="{Binding HasDetailsError, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding DetailsError, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" />
                        </Border>

                        <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                            <!-- Qui signe les commits de ce projet (F2) -->
                            <TextBlock Text="COMMITS SIGNÉS PAR" Style="{StaticResource SectionLabel}" />
                            <ComboBox ItemsSource="{Binding IdentityChoices}" SelectedItem="{Binding SelectedIdentityChoice}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="Commits signés par" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                      ToolTip="Nom et e-mail enregistrés dans chaque commit : c'est ce qui décide à quel compte GitHub le commit est attribué" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Margin="0,2,8,0" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                            <Setter Property="Text" Value="&#xE946;" />
                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IdentityMatches}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IdentityMismatch}" Value="True">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding IdentityStatus}" TextWrapping="Wrap" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IdentityMismatch}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding FixUnpushedAuthorsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Visibility="{Binding HasForeignUnpushed, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                    ToolTip="Ces commits ne sont pas encore sur GitHub : on peut changer leur signature sans rien forcer. Contenu et dates inchangés.">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="{Binding FixAuthorsLabel}" /></StackPanel>
                            </Button>

                            <TextBlock Style="{StaticResource SectionLabel}"><Run Text="BRANCHE " /><Run Text="{Binding BranchLabel, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{Binding TrackingLabel}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                       ToolTip="Calculé d'après le dernier « Récupérer » : GitSpread ne contacte pas GitHub pour cet affichage." />
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding RestoreStashCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Visibility="{Binding HasPendingStash, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Des modifications ont été mises de côté en quittant cette branche">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Restaurer les modifications mises de côté" /></StackPanel>
                            </Button>

                            <StackPanel Visibility="{Binding HasSideBranches, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource SectionLabel}"><Run Text="AUTRES BRANCHES, COMPARÉES À " /><Run Text="{Binding MainBranch, Mode=OneWay}" /></TextBlock>
                                <ItemsControl ItemsSource="{Binding SideBranches}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SideBranchViewModel}">
                                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource Pill}" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                                                                Visibility="{Binding HasWhere, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{DynamicResource Muted}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <WrapPanel Margin="-6,2,0,0">
                                                        <Button Style="{StaticResource GhostButton}" Command="{Binding IntegrateCommand}" Margin="0,0,4,0"
                                                                Visibility="{Binding CanIntegrate, Converter={StaticResource BoolToVisibility}}"
                                                                AutomationProperties.Name="{Binding IntegrateLabel}">
                                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="{Binding IntegrateLabel}" FontSize="12" /></StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostButton}" Command="{Binding UpdateCommand}"
                                                                Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                                                                AutomationProperties.Name="{Binding UpdateLabel}">
                                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="{Binding UpdateLabel}" FontSize="12" /></StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="ÉTAT DU DOSSIER" Style="{StaticResource SectionLabel}" />
                            <Border CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClean}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="DERNIER COMMIT" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding LastCommitSubject}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastCommitMeta}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" />

                        </StackPanel>

                        <WrapPanel Margin="0,20,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" Margin="0,0,6,0" />
                                    <TextBlock Text="Ouvrir le dossier" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenOnGitHubCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding CanOpenOnGitHub, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" Margin="0,0,6,0" />
                                    <TextBlock Text="Voir sur GitHub" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
