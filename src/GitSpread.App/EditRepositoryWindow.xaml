<Window x:Class="GitSpread.App.EditRepositoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
        xmlns:controls="clr-namespace:GitSpread.App.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:EditRepositoryViewModel}"
        Width="600" SizeToContent="Height" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Annuler" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer sur GitHub" Command="{Binding SaveCommand}" IsDefault="True"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource Not}}" />
            </StackPanel>
        </Border>
        <StackPanel Margin="24,18,24,18">
            <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="Modifier " /><Run Text="{Binding FullName, Mode=OneWay}" /></TextBlock>

            <controls:Field Label="Description" Margin="0,16,0,0" Hint="Une phrase qui dit à quoi sert le projet (visible sur GitHub).">
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" TextWrapping="Wrap" />
            </controls:Field>
            <controls:Field Label="Site web" Error="{Binding HomepageError}" Margin="0,14,0,0" Hint="Facultatif : l'adresse du site ou de la démo.">
                <TextBox Text="{Binding Homepage, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
            </controls:Field>
            <controls:Field Label="Sujets" Error="{Binding TopicsError}" Margin="0,14,0,0"
                            Hint="Mots-clés séparés par des virgules (ex. php, prestashop, gestion de stock).">
                <TextBox Text="{Binding TopicsText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
            </controls:Field>
            <TextBlock Text="{Binding TopicsPreview}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />

            <Border Background="{DynamicResource DangerSoft}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBox Text="{Binding SaveError, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" />
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
