<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette sombre. Contrastes texte / fond ≥ 4.5:1 (WCAG AA). -->
    <SolidColorBrush x:Key="Bg" Color="#0D1117" />
    <SolidColorBrush x:Key="Surface" Color="#161B22" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1B2129" />
    <SolidColorBrush x:Key="Border" Color="#30363D" />
    <SolidColorBrush x:Key="Text" Color="#E6EDF3" />
    <SolidColorBrush x:Key="Muted" Color="#9198A1" />
    <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1A2740" />
    <!-- Fond des boutons principaux : texte blanc lisible (contraste ≥ 4.5:1) -->
    <SolidColorBrush x:Key="AccentButton" Color="#1F6FEB" />
    <SolidColorBrush x:Key="Success" Color="#3FB950" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#12261A" />
    <SolidColorBrush x:Key="SuccessBorder" Color="#1F4D2B" />
    <SolidColorBrush x:Key="Warning" Color="#D29922" />
    <SolidColorBrush x:Key="WarningSoft" Color="#2A2213" />
    <SolidColorBrush x:Key="Danger" Color="#F85149" />
    <SolidColorBrush x:Key="DangerSoft" Color="#2C1517" />
    <SolidColorBrush x:Key="DangerBorder" Color="#5C2125" />
    <SolidColorBrush x:Key="SegmentBg" Color="#21262D" />
    <SolidColorBrush x:Key="TabHover" Color="#1C2128" />
    <SolidColorBrush x:Key="CodeBg" Color="#010409" />
    <SolidColorBrush x:Key="CodeText" Color="#E6EDF3" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

    <!-- Graphe des branches (F6a) : principale en bleu franc, branches classiques en bleus clairs, maintenance en jaune / orange / rouge -->
    <SolidColorBrush x:Key="BranchMain" Color="#3B82F6" />
    <SolidColorBrush x:Key="BranchNeutral" Color="#6E7681" />
    <SolidColorBrush x:Key="BranchClassic0" Color="#93C5FD" />
    <SolidColorBrush x:Key="BranchClassic1" Color="#67E8F9" />
    <SolidColorBrush x:Key="BranchClassic2" Color="#A5B4FC" />
    <SolidColorBrush x:Key="BranchClassic3" Color="#7DD3FC" />
    <SolidColorBrush x:Key="BranchClassic4" Color="#99F6E4" />
    <SolidColorBrush x:Key="BranchClassic5" Color="#C7D2FE" />
    <SolidColorBrush x:Key="BranchMaint0" Color="#FACC15" />
    <SolidColorBrush x:Key="BranchMaint1" Color="#FB923C" />
    <SolidColorBrush x:Key="BranchMaint2" Color="#F87171" />
    <SolidColorBrush x:Key="BranchMaint3" Color="#FDE68A" />
    <SolidColorBrush x:Key="BranchMaint4" Color="#F97316" />
    <SolidColorBrush x:Key="BranchMaint5" Color="#EF4444" />
    <SolidColorBrush x:Key="DiffAddedBg" Color="#16301F" />
    <SolidColorBrush x:Key="DiffAddedText" Color="#7EE787" />
    <SolidColorBrush x:Key="DiffRemovedBg" Color="#3A1A1D" />
    <SolidColorBrush x:Key="DiffRemovedText" Color="#FFA198" />
</ResourceDictionary>
