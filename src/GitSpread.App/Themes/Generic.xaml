<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GitSpread.App.Controls">

    <!-- Champ de formulaire : libellé, saisie encadrée, aide, erreur en rouge sous le champ -->
    <Style TargetType="controls:Field">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Field">
                    <StackPanel>
                        <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap" />
                        <Border x:Name="Frame" BorderThickness="1.5" BorderBrush="Transparent" CornerRadius="6" Padding="1">
                            <ContentPresenter />
                        </Border>
                        <!-- DockPanel (et non StackPanel horizontal) : le message se replie sur la largeur disponible -->
                        <DockPanel x:Name="ErrorRow" Margin="1,5,0,0" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Danger}" Margin="0,2,6,0" VerticalAlignment="Top" />
                            <TextBlock Text="{TemplateBinding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="HintText" Text="{TemplateBinding Hint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="1,4,0,0" />
                        <TextBlock x:Name="CheckingText" Text="Vérification…" Foreground="{DynamicResource Muted}" FontSize="12" Margin="1,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Hint" Value="{x:Null}">
                            <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecking" Value="True">
                            <Setter TargetName="CheckingText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Danger}" />
                            <Setter TargetName="ErrorRow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
