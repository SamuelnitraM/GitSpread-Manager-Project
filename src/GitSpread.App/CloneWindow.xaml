<Window x:Class="GitSpread.App.CloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
        xmlns:controls="clr-namespace:GitSpread.App.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CloneViewModel}"
        Width="640" SizeToContent="Height" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Annuler" Command="{Binding CloseCommand}" Margin="0,0,8,0"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Form}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Cloner" Command="{Binding CloneCommand}" IsDefault="True"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Form}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Modifier et réessayer" Command="{Binding BackToFormCommand}" Margin="0,0,8,0"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Fermer" Command="{Binding CloseCommand}"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done|Failed}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,18,24,18">
            <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="Cloner " /><Run Text="{Binding FullName, Mode=OneWay}" /></TextBlock>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Crée une copie du repo sur ce poste, avec son historique, et l'ajoute à GitSpread." />

            <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Form}">
                <controls:Field Label="Dans le dossier" Error="{Binding ParentFolderError}" Margin="0,16,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Parcourir…" Click="Browse_Click" Margin="8,0,0,0" />
                        <TextBox Text="{Binding ParentFolder, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" AutomationProperties.Name="Dossier parent" />
                    </DockPanel>
                </controls:Field>
                <controls:Field Label="Nom du dossier du projet" Error="{Binding FolderNameError}" Margin="0,14,0,0">
                    <TextBox Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                </controls:Field>
                <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
                    <Run Text="Le projet sera créé dans : " /><Run Text="{Binding TargetPath, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <CheckBox IsChecked="{Binding SignWithAccount}" Margin="0,14,0,0">
                    <TextBlock Text="{Binding SignLabel}" TextWrapping="Wrap" />
                </CheckBox>
                <Border Background="{DynamicResource CodeBg}" CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
                    <TextBlock Text="{Binding CommandPreview, StringFormat='&gt; {0}'}" Foreground="{DynamicResource CodeText}" FontFamily="Consolas" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <StackPanel Margin="0,14,0,0" Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Running|Done|Failed}">
                <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="Transparent" Margin="0,0,0,12"
                             Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Running}" />
                <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Background="{DynamicResource SuccessSoft}"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done}">
                    <TextBox Text="{Binding ResultMessage, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                </Border>
                <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Background="{DynamicResource DangerSoft}"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}">
                    <TextBox Text="{Binding ResultMessage, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Progress}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='•  {0}'}" Foreground="{DynamicResource Muted}" Margin="0,2" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
