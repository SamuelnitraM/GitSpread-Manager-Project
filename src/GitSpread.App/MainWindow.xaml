<Window x:Class="GitSpread.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:GitSpread.App"
        xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
        xmlns:views="clr-namespace:GitSpread.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="GitSpread" Width="1400" Height="860" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/GitSpread.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static app:MainWindow.AddAccountCommand}" Executed="AddAccount_Executed" />
        <CommandBinding Command="{x:Static app:MainWindow.SettingsCommand}" Executed="Settings_Click" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static app:MainWindow.AddAccountCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static app:MainWindow.SettingsCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- ===== En-têtes d'onglets ===== -->
        <DataTemplate x:Key="AccountHeader" DataType="{x:Type vm:AccountTabViewModel}">
            <StackPanel Orientation="Horizontal" Margin="2,1">
                <!-- Compte actif : point vert qui clignote + nom surligné en vert -->
                <Border x:Name="NameBox" CornerRadius="6" Padding="6,1" Margin="-6,-1,0,-1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ActiveDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource Success}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="Compte actif dans gh (celui qu'utilise gh dans ton terminal). GitSpread, lui, choisit toujours le bon compte pour chaque projet."
                                 AutomationProperties.Name="Compte actif">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.9">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" Margin="0,0,8,0"
                                   Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock x:Name="LoginText" Text="{Binding Login}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding HostLabel}" Foreground="{DynamicResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Projets sur ce poste rattachés à ce compte">
                    <TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding ProjectCount}" Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Repos sur GitHub (y compris ceux où ce compte est collaborateur)">
                    <TextBlock Text="&#xE753;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding RepositoryCount}" Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Margin="4,0,0,0" Padding="6,1" Click="Switch_Click" AutomationProperties.Name="Changer de compte actif"
                        Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Changer le compte actif de gh (gh auth switch)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,4,0" />
                        <TextBlock Text="switch" FontSize="11" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource Pill}" Background="{DynamicResource DangerSoft}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="erreur" FontSize="11" Foreground="{DynamicResource Danger}" />
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="NameBox" Property="Background" Value="{DynamicResource SuccessSoft}" />
                    <Setter TargetName="LoginText" Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="OtherHeader" DataType="{x:Type vm:UnlinkedTabViewModel}">
            <StackPanel Orientation="Horizontal" Margin="2,1">
                <TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Projets sur ce poste">
                    <TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding ProjectCount}" Foreground="{DynamicResource Muted}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Contenus d'onglets ===== -->
        <DataTemplate x:Key="AccountContent" DataType="{x:Type vm:AccountTabViewModel}">
            <Grid>
            <!-- Historique en grand, à la place du contenu de l'onglet -->
            <views:HistoryExplorerView DataContext="{Binding Explorer}"
                                       Visibility="{Binding DataContext.IsExplorerOpen, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}" />
            <DockPanel Visibility="{Binding IsExplorerOpen, Converter={StaticResource InverseBoolToVisibility}}">
                <Border DockPanel.Dock="Top" Margin="16,12,16,0" Background="{DynamicResource SegmentBg}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton AutomationProperties.Name="Projets locaux" Style="{StaticResource SegmentButton}" IsChecked="{Binding ShowRepositories, Converter={StaticResource Not}}">
                            <TextBlock><Run Text="Projets locaux  " /><Run Text="{Binding ProjectCount, Mode=OneWay}" Foreground="{DynamicResource Muted}" /></TextBlock>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Repos sur GitHub" Style="{StaticResource SegmentButton}" IsChecked="{Binding ShowRepositories}">
                            <TextBlock><Run Text="Repos sur GitHub  " /><Run Text="{Binding RepositoryCount, Mode=OneWay}" Foreground="{DynamicResource Muted}" /></TextBlock>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <!-- Aperçu de l'historique sur toute la largeur, en bas (F6a) -->
                <views:HistoryPreview DockPanel.Dock="Bottom" DataContext="{Binding History}" />
                <Grid>
                    <views:ProjectsView Visibility="{Binding ShowRepositories, Converter={StaticResource InverseBoolToVisibility}}" />
                    <views:RepositoriesView Visibility="{Binding ShowRepositories, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OtherContent" DataType="{x:Type vm:UnlinkedTabViewModel}">
            <Grid>
                <views:HistoryExplorerView DataContext="{Binding Explorer}"
                                           Visibility="{Binding DataContext.IsExplorerOpen, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}" />
                <DockPanel Visibility="{Binding IsExplorerOpen, Converter={StaticResource InverseBoolToVisibility}}">
                    <views:HistoryPreview DockPanel.Dock="Bottom" DataContext="{Binding History}" />
                    <views:ProjectsView />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <app:TabTemplateSelector x:Key="HeaderSelector" Account="{StaticResource AccountHeader}" Other="{StaticResource OtherHeader}" />
        <app:TabTemplateSelector x:Key="ContentSelector" Account="{StaticResource AccountContent}" Other="{StaticResource OtherContent}" />

        <Style x:Key="AccountTabItem" TargetType="TabItem">
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="ToolTip" Value="Glisse l'onglet pour le déplacer. Dépose un projet ici pour le passer sur ce compte. Clic droit : gérer le compte." />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Tab_PreviewMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="Tab_PreviewMouseMove" />
            <EventSetter Event="DragEnter" Handler="Tab_DragOver" />
            <EventSetter Event="DragOver" Handler="Tab_DragOver" />
            <EventSetter Event="DragLeave" Handler="Tab_DragLeave" />
            <EventSetter Event="Drop" Handler="Tab_Drop" />
            <!-- Menu du compte : clic droit, touche Menu ou Maj+F10 -->
            <EventSetter Event="ContextMenuOpening" Handler="Tab_ContextMenuOpening" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,2,-1">
                            <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                    CornerRadius="8,8,0,0" Padding="12,7" Cursor="Hand">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <!-- Repère d'insertion pendant le déplacement d'un onglet -->
                            <Rectangle x:Name="InsertMark" Width="3" HorizontalAlignment="Left" Margin="-2,4,0,4" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                            <Rectangle x:Name="InsertMarkAfter" Width="3" HorizontalAlignment="Right" Margin="0,4,-3,4" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Surface}" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Border}" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource TabHover}" />
                            </MultiTrigger>
                            <DataTrigger Binding="{Binding DropHint}" Value="InsertBefore">
                                <Setter TargetName="InsertMark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropHint}" Value="InsertAfter">
                                <Setter TargetName="InsertMarkAfter" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropHint}" Value="Project">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                                <Setter TargetName="Tab" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- En-tête -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Click="AddProject_Click" Margin="0,0,8,0"
                            ToolTip="Ajouter un ou plusieurs dossiers de projet, où qu'ils soient, même sans git">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                            <TextBlock Text="Ajouter un projet" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="Settings_Click" Margin="0,0,8,0" AutomationProperties.Name="Paramètres"
                            ToolTip="Apparence, réglages git, dossiers de projets, comptes et identités (Ctrl+,)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                            <TextBlock Text="Paramètres" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"
                            ToolTip="Relancer la détection des comptes, des repos et des projets (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                            <TextBlock Text="Actualiser" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/GitSpread.ico" Width="32" Height="32" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GitSpread" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Tes projets git, rangés par compte GitHub, sans taper de commande" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Muted}">
                    <Hyperlink Click="OpenLogs_Click" ToolTip="{Binding LogDirectory}">Journaux</Hyperlink>
                </TextBlock>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <DockPanel Margin="20,12,20,16">
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8" BorderThickness="0"
                         Foreground="{DynamicResource Accent}" Background="Transparent"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <Border DockPanel.Dock="Top" Margin="0,0,0,10" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10"
                    Visibility="{Binding HasGlobalError, Converter={StaticResource BoolToVisibility}}">
                <TextBox Text="{Binding GlobalError, Mode=OneWay}" Style="{StaticResource SelectableText}" />
            </Border>

            <Border DockPanel.Dock="Top" Margin="0,0,0,10" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="14,8"
                    Visibility="{Binding HasNoRootFolders, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Choisir des dossiers" Click="SettingsProjects_Click" />
                    <TextBlock Text="Aucun dossier de projets n'est configuré : indique à GitSpread où chercher tes projets." VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Onglets : un par compte + « Non liés / autres », puis le bouton + -->
            <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                        ItemTemplateSelector="{StaticResource HeaderSelector}"
                        ContentTemplateSelector="{StaticResource ContentSelector}"
                        ItemContainerStyle="{StaticResource AccountTabItem}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <TabPanel IsItemsHost="True" Panel.ZIndex="1" />
                                <Button Style="{StaticResource GhostButton}" Click="AddAccount_Click" AutomationProperties.Name="Connecter un compte" Margin="6,0,0,4" Padding="8,5" VerticalAlignment="Center"
                                        ToolTip="Connecter un nouveau compte GitHub (gh auth login) · Ctrl+N">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="0,8,8,8">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>
