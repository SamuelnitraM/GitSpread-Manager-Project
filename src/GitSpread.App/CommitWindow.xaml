<Window x:Class="GitSpread.App.CommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CommitViewModel}"
        Title="Commit" Width="720" Height="680" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=MessageInput}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding PushAfterCommit}" Content="Pousser sur GitHub ensuite"
                          Visibility="{Binding CanPushAfter, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Annuler" IsCancel="True" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Commiter" IsDefault="True" Click="Commit_Click" IsEnabled="{Binding CanCommit}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10">
                <Run Text="Commit dans " /><Run Text="{Binding ProjectName, Mode=OneWay}" />
            </TextBlock>

            <Border Grid.Row="1" Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding ShowGitignoreAdvice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Warning}"
                               Text="Ce projet n'a pas de .gitignore. Les dossiers de dépendances (node_modules, vendor, bin...) sont décochés : inutile de les envoyer sur GitHub. Un .gitignore les écarte définitivement." />
                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Content="{Binding AddGitignoreLabel}" Command="{Binding AddGitignoreCommand}"
                            Visibility="{Binding CanAddGitignore, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding GitignoreResult}" Foreground="{DynamicResource Success}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowGitignoreAdvice}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DockPanel Grid.Row="2" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right"><Hyperlink Command="{Binding ToggleAllCommand}">Tout cocher / décocher</Hyperlink></TextBlock>
                <TextBlock Text="Fichiers à inclure" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectionSummary}" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" />
            </DockPanel>

            <Grid Grid.Row="3">
                <ListBox ItemsSource="{Binding Changes}" BorderBrush="{DynamicResource Border}" Padding="2" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChangeItemViewModel}">
                            <DockPanel Margin="2,3">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border DockPanel.Dock="Left" Width="104" CornerRadius="10" Padding="7,1" Margin="0,0,10,0" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Untracked"><Setter Property="Background" Value="{DynamicResource SuccessSoft}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Added"><Setter Property="Background" Value="{DynamicResource SuccessSoft}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Deleted"><Setter Property="Background" Value="{DynamicResource DangerSoft}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Conflicted"><Setter Property="Background" Value="{DynamicResource DangerSoft}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Renamed"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="dépendances / fichiers générés" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"
                                           Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVisibility}}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Aucune modification à commiter." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasChanges, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="Message" FontWeight="SemiBold" />
                <TextBlock Text="Décris en une phrase ce que tu as changé (ex. « Corrige le calcul du stock »)." Foreground="{DynamicResource Muted}" Margin="0,2,0,6" />
                <TextBox x:Name="MessageInput" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="64" Padding="6" VerticalScrollBarVisibility="Auto" BorderBrush="{DynamicResource Border}" />
                <!-- F3B : créditer les autres comptes liés au projet -->
                <ItemsControl ItemsSource="{Binding CoAuthors}" Margin="0,6,0,0" Visibility="{Binding HasCoAuthors, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CoAuthorChoice}">
                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" Margin="0,2" AutomationProperties.Name="{Binding Label}"
                                      ToolTip="Ajoute une ligne « Co-authored-by » au message : GitHub affiche alors ce compte comme contributeur du commit" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Qui signe le commit -->
            <StackPanel Grid.Row="5" Margin="0,12,0,0" DataContext="{Binding Identity}">
                <TextBlock>
                    <Run Text="Signé par : " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <Border Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="10,8" Margin="0,6,0,0"
                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" />
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding DataContext.UseSuggestedIdentityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding CanUseSuggested, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock><Run Text="Utiliser " /><Run Text="{Binding SuggestedLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" pour ce projet" /></TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="C'est bien mon adresse"
                                Command="{Binding ConfirmEmailCommand}" Visibility="{Binding CanConfirmEmail, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="GitSpread s'en souviendra pour ce compte et ne t'avertira plus" />
                <TextBlock Text="{Binding DataContext.IdentityResult, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource Success}"
                           TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="6" Background="{DynamicResource CodeBg}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                <TextBlock Text="{Binding CommandsPreview}" Foreground="{DynamicResource CodeText}" FontFamily="Consolas" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
