<Window x:Class="GitSpread.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GitSpread.App.ViewModels"
        xmlns:controls="clr-namespace:GitSpread.App.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LoginWizardViewModel}"
        Title="Connecter un compte GitHub" Width="640" Height="620" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Question telle que posée par gh, rappelée sous la question traduite -->
        <Style x:Key="GhQuestion" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Question" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ChoiceTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ChoiceText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Pied : navigation -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Annuler" Command="{Binding CancelCommand}"
                        Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Host|Protocol|GitCredentials|SshKey|Method|Token|Summary|Running}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Retour" Command="{Binding BackCommand}" Margin="0,0,8,0"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Suivant" Command="{Binding NextCommand}" IsDefault="True"
                            Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Host|Protocol|GitCredentials|SshKey|Method|Token}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Lancer la connexion" Command="{Binding StartCommand}"
                            Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Summary}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Modifier et réessayer" Command="{Binding RetryCommand}" Margin="0,0,8,0"
                            Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Fermer" Command="{Binding CloseCommand}"
                            Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done|Failed}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22,28,20">
                <TextBlock Text="{Binding StepTitle}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,0,6" />

                <!-- ================= 1. Hôte ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Host}">
                    <TextBlock Text="Où utilises-tu GitHub ?" Style="{StaticResource Question}" />
                    <TextBlock Text="gh › ? Where do you use GitHub?" Style="{StaticResource GhQuestion}" />
                    <RadioButton GroupName="UseGitHubCom" Style="{StaticResource ChoiceCard}" IsChecked="{Binding UseGitHubCom}">
                        <StackPanel>
                            <TextBlock Text="GitHub.com" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Le site public github.com (le cas le plus courant)." Style="{StaticResource ChoiceText}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="UseGitHubCom" Style="{StaticResource ChoiceCard}" IsChecked="{Binding UseGitHubCom, Converter={StaticResource Not}}">
                        <StackPanel>
                            <TextBlock Text="Autre (GitHub Enterprise Server)" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Le serveur GitHub de ton entreprise." Style="{StaticResource ChoiceText}" />
                            <controls:Field Error="{Binding HostError}" Margin="0,8,0,0">
                                <TextBox Text="{Binding CustomHost, UpdateSourceTrigger=PropertyChanged}" Padding="4" AutomationProperties.Name="Nom d'hôte"
                                         IsEnabled="{Binding UseGitHubCom, Converter={StaticResource Not}}" ToolTip="Nom d'hôte, ex. github.monentreprise.fr" />
                            </controls:Field>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- ================= 2. Protocole ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Protocol}">
                    <TextBlock Text="Quel protocole préfères-tu pour les opérations git ?" Style="{StaticResource Question}" />
                    <TextBlock Text="gh › ? What is your preferred protocol for Git operations on this host?" Style="{StaticResource GhQuestion}" />
                    <RadioButton GroupName="UseSsh" Style="{StaticResource ChoiceCard}" IsChecked="{Binding UseSsh, Converter={StaticResource Not}}">
                        <StackPanel>
                            <TextBlock Text="HTTPS" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Le plus simple : aucune clé à gérer. GitSpread fournit le bon compte à git pour chaque projet." Style="{StaticResource ChoiceText}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="UseSsh" Style="{StaticResource ChoiceCard}" IsChecked="{Binding UseSsh}">
                        <StackPanel>
                            <TextBlock Text="SSH" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Utilise une clé SSH. Pratique si tu as déjà une clé par compte." Style="{StaticResource ChoiceText}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- ================= 3a. Identifiants git (HTTPS) ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=GitCredentials}">
                    <TextBlock Text="Configurer git pour utiliser ce compte ?" Style="{StaticResource Question}" />
                    <TextBlock Text="gh › ? Authenticate Git with your GitHub credentials?" Style="{StaticResource GhQuestion}" />
                    <RadioButton GroupName="ConfigureGitCredentials" Style="{StaticResource ChoiceCard}" IsChecked="{Binding ConfigureGitCredentials, Converter={StaticResource Not}}">
                        <StackPanel>
                            <TextBlock Text="Non (recommandé avec GitSpread)" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Ta configuration git ne change pas. Dans GitSpread, chaque projet utilise automatiquement le compte auquel il appartient." Style="{StaticResource ChoiceText}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ConfigureGitCredentials" Style="{StaticResource ChoiceCard}" IsChecked="{Binding ConfigureGitCredentials}">
                        <StackPanel>
                            <TextBlock Text="Oui" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Style="{StaticResource ChoiceText}">
                                gh devient le gestionnaire d'identifiants de git (gh auth setup-git). Dans ton terminal, git utilisera alors le compte <Bold>actif</Bold> de gh, quel que soit le projet.
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- ================= 3b. Clé SSH ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=SshKey}">
                    <TextBlock Text="Envoyer une clé SSH publique sur ce compte ?" Style="{StaticResource Question}" />
                    <TextBlock Text="gh › ? Upload your SSH public key to your GitHub account?" Style="{StaticResource GhQuestion}" />
                    <RadioButton GroupName="SshChoice" Style="{StaticResource ChoiceCard}" IsChecked="{Binding SshChoice, Converter={StaticResource EnumToBool}, ConverterParameter=Existing}"
                                 Visibility="{Binding HasSshKeys, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Utiliser une clé existante" Style="{StaticResource ChoiceTitle}" />
                            <controls:Field Error="{Binding SshKeyError}" Margin="0,8,0,0">
                            <ComboBox ItemsSource="{Binding SshKeys}" SelectedItem="{Binding SelectedSshKey}" AutomationProperties.Name="Clé SSH"
                                      IsEnabled="{Binding SshChoice, Converter={StaticResource EnumToBool}, ConverterParameter=Existing}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock><Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Comment, Mode=OneWay}" Foreground="{DynamicResource Muted}" /></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            </controls:Field>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="SshChoice" Style="{StaticResource ChoiceCard}" IsChecked="{Binding SshChoice, Converter={StaticResource EnumToBool}, ConverterParameter=Generate}">
                        <StackPanel>
                            <TextBlock Text="Générer une nouvelle clé" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Une clé ed25519 dédiée à ce compte (id_ed25519_&lt;compte&gt;) sera créée dans ton dossier .ssh." Style="{StaticResource ChoiceText}" />
                            <TextBlock Text="Phrase secrète (facultative)" Margin="0,8,0,2" />
                            <TextBlock Text="gh › ? Enter a passphrase for your new SSH key (Optional)" Style="{StaticResource GhQuestion}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="PassphraseBox" PasswordChanged="Passphrase_Changed" Padding="4"
                                         IsEnabled="{Binding SshChoice, Converter={StaticResource EnumToBool}, ConverterParameter=Generate}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="SshChoice" Style="{StaticResource ChoiceCard}" IsChecked="{Binding SshChoice, Converter={StaticResource EnumToBool}, ConverterParameter=Skip}">
                        <StackPanel>
                            <TextBlock Text="Ne pas envoyer de clé" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Tu pourras en ajouter une plus tard." Style="{StaticResource ChoiceText}" />
                        </StackPanel>
                    </RadioButton>
                    <StackPanel Visibility="{Binding SshChoice, Converter={StaticResource EnumToVisibility}, ConverterParameter=Existing|Generate}">
                        <TextBlock Text="Titre de la clé sur GitHub" Margin="0,6,0,2" />
                        <TextBlock Text="gh › ? Title for your SSH key:" Style="{StaticResource GhQuestion}" Margin="0,0,0,4" />
                        <controls:Field Error="{Binding SshTitleError}">
                            <TextBox Text="{Binding SshKeyTitle, UpdateSourceTrigger=PropertyChanged}" Padding="4" AutomationProperties.Name="Titre de la clé" />
                        </controls:Field>
                    </StackPanel>
                </StackPanel>

                <!-- ================= 4. Méthode ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Method}">
                    <TextBlock Text="Comment veux-tu te connecter ?" Style="{StaticResource Question}" />
                    <TextBlock Text="gh › ? How would you like to authenticate GitHub CLI?" Style="{StaticResource GhQuestion}" />
                    <RadioButton GroupName="UseBrowser" Style="{StaticResource ChoiceCard}" IsChecked="{Binding UseBrowser}">
                        <StackPanel>
                            <TextBlock Text="Avec le navigateur" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Tu recevras un code à saisir sur github.com." Style="{StaticResource ChoiceText}" />
                            <Border Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="8,5" Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Warning}"
                                           Text="Dans le navigateur, sois connecté au compte que tu veux ajouter. Une fenêtre de navigation privée évite de valider avec le mauvais compte." />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="UseBrowser" Style="{StaticResource ChoiceCard}" IsChecked="{Binding UseBrowser, Converter={StaticResource Not}}">
                        <StackPanel>
                            <TextBlock Text="En collant un token d'accès" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Un token d'accès personnel (classique) avec au minimum les droits repo et read:org." Style="{StaticResource ChoiceText}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- ================= 5. Token ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Token}">
                    <TextBlock Text="Colle ton token d'accès" Style="{StaticResource Question}" />
                    <TextBlock Text="gh › ? Paste your authentication token:" Style="{StaticResource GhQuestion}" />
                    <controls:Field Error="{Binding TokenError}">
                        <PasswordBox x:Name="TokenBox" PasswordChanged="Token_Changed" Padding="6" FontFamily="Consolas" AutomationProperties.Name="Token d'accès" />
                    </controls:Field>
                    <TextBlock Style="{StaticResource ChoiceText}" Margin="0,8,0,0">
                        Droits nécessaires : <Bold>repo</Bold>, <Bold>read:org</Bold> (et <Bold>admin:public_key</Bold> si tu envoies une clé SSH).
                        Le token est transmis directement à gh, qui le range dans le gestionnaire d'identifiants de Windows. GitSpread ne l'enregistre nulle part.
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink Click="CreateToken_Click">Créer un token sur GitHub</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- ================= Récapitulatif ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Summary}">
                    <TextBlock Text="Voici ce que GitSpread va exécuter" Style="{StaticResource Question}" Margin="0,0,0,12" />
                    <Border Background="{DynamicResource CodeBg}" CornerRadius="8" Padding="14,10">
                        <ItemsControl ItemsSource="{Binding CommandsPreview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='&gt; {0}'}" Foreground="{DynamicResource CodeText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <CheckBox IsChecked="{Binding KeepPreviousActive}" Margin="0,14,0,0"
                              Visibility="{Binding HasPreviousActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap">
                            Garder <Run Text="{Binding PreviousActive, Mode=OneWay}" FontWeight="SemiBold" /> comme compte actif ensuite
                            <Run Text="(sinon gh rend actif le nouveau compte)" Foreground="{DynamicResource Muted}" />
                        </TextBlock>
                    </CheckBox>
                </StackPanel>

                <!-- ================= En cours ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Running}">
                    <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="Transparent" Margin="0,0,0,14" />

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14"
                            Visibility="{Binding HasDeviceCode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="1. Copie ce code à usage unique" FontWeight="SemiBold" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Copier" Command="{Binding CopyCodeCommand}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeviceCode}" FontFamily="Consolas" FontSize="30" FontWeight="Bold" />
                            </DockPanel>
                            <TextBlock Text="gh l'a déjà placé dans ton presse-papiers." Foreground="{DynamicResource Muted}" FontSize="12" />
                            <TextBlock Text="2. Colle-le sur la page GitHub et valide" FontWeight="SemiBold" Margin="0,14,0,8" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenDeviceUrlCommand}" HorizontalAlignment="Left">
                                <TextBlock><Run Text="Ouvrir " /><Run Text="{Binding DeviceUrl, Mode=OneWay}" /></TextBlock>
                            </Button>
                            <TextBlock Text="Vérifie que le navigateur est connecté au compte à ajouter avant de valider." Foreground="{DynamicResource Warning}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Progress}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='•  {0}'}" Foreground="{DynamicResource Muted}" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ================= Terminé ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done}">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource Success}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource Question}">
                            <Run Text="{Binding ConnectedLogin, Mode=OneWay}" /> est connecté
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Il a maintenant son propre onglet, avec ses projets et ses repos." Foreground="{DynamicResource Muted}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Progress}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='✓  {0}'}" Foreground="{DynamicResource Muted}" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ================= Échec ================= -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}">
                    <Border Background="{DynamicResource DangerSoft}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{DynamicResource Danger}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Progress}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='•  {0}'}" Foreground="{DynamicResource Muted}" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
